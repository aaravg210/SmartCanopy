# SmartCanopy Environment Configuration
# Copy this file to .env and fill in your values

# ── Backend (FastAPI) ──────────────────────────────────────────────────────────

# PostgreSQL — use Supabase connection string for production
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://smartcanopy:your-password@localhost:5432/smartcanopy

# For docker-compose dev (used by postgres container)
DB_PASSWORD=your-password-here

# Redis — use Upstash Redis URL for production (rediss:// for TLS)
REDIS_URL=redis://localhost:6379/0

# Google Earth Engine auth.
# Local dev:  run `earthengine authenticate` (uses Application Default Credentials)
# Production: paste the contents of a GCP Service Account JSON key below.
#             The SA must have Earth Engine API access.
GEE_PROJECT=urban-tree-ai
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# OSM cache directory (populated by: python scripts/refresh_osm_cache.py)
OSM_CACHE_DIR=cache

# ── Frontend (Next.js on Vercel) ───────────────────────────────────────────────

# Mapbox public token — safe to expose client-side; restrict to your domains
# in the Mapbox console under Token Scopes → URL restrictions.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ...

# Backend API base URL (without trailing slash).
# Vercel: set to your Oracle Cloud / Railway public URL.
# Local dev: typically handled by Next.js rewrites in next.config.js.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Application settings ───────────────────────────────────────────────────────
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# ── Cache TTLs (seconds) ───────────────────────────────────────────────────────
CACHE_TTL_SPECIES_REC=3600        # 1 hour
CACHE_TTL_SESSION=86400           # 24 hours
